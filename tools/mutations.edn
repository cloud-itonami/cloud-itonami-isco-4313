 ;; --------------------------------------------------------------------------
 ;; 社会保険・労働保険 (2026-08-18)
 ;;
 ;; Written BEFORE the new tests were re-read, which is the only way this
 ;; table measures anything: a mutation designed against a test measures the
 ;; test author's memory.
 ;; --------------------------------------------------------------------------

 ;; The one rate this workspace read out of a statute
 ;; (厚生年金保険法 第八十一条第四項, 千分の百八十三・〇〇). If nothing notices
 ;; it moving, the amount check is decoration.
 {:id :pension-rate-is-the-statutory-one
  :invariant "厚年法 第八十一条第四項 の 千分の百八十三 が実際に使われている"
  :file "src/payroll/shakai_hoken.cljc"
  :find "      :rate/per-mille 183"
  :replace "      :rate/per-mille 184"}

 ;; 厚年法 第八十二条第一項: 被保険者 bears HALF. Dropping the /2 doubles every
 ;; employee's pension contribution.
 {:id :the-employee-bears-half-of-the-pension-premium
  :invariant "厚年法 第八十二条第一項 の折半（分母 2000 = 1000 × 2）"
  :file "src/payroll/shakai_hoken.cljc"
  :find "{:numerator (* srm per-mille) :denominator 2000 :unit :yen}"
  :replace "{:numerator (* srm per-mille) :denominator 1000 :unit :yen}"}

 ;; The bound is STRICT: any whole-yen rendering differs from the exact value
 ;; by strictly less than one yen, so an amount exactly one yen out is wrong.
 {:id :the-one-yen-bound-is-strict
  :invariant "端数処理規則を読まずに言える限界は < であって <= ではない"
  :file "src/payroll/shakai_hoken.cljc"
  :find "  (< (abs* (- (* declared denominator) numerator)) denominator))"
  :replace "  (<= (abs* (- (* declared denominator) numerator)) denominator))"}

 ;; The whole point: an unobserved 資格 is NOT `this worker is not insured`.
 {:id :unobserved-coverage-is-not-not-covered
  :invariant "資格未登録は「該当しない」ではない（未観測は合格ではない）"
  :file "src/payroll/shakai_hoken.cljc"
  :find "                 (nil? covered) :coverage-not-observed"
  :replace "                 (nil? covered) :not-covered"}

 ;; A registration that is the STRING "true" is not a registration.
 {:id :a-string-true-is-not-a-registration
  :invariant "boolean? による正規化（typo で買える合格を作らない）"
  :file "src/payroll/shakai_hoken.cljc"
  :find "  (when (boolean? x) x))"
  :replace "  x)"}

 ;; Reclassifying a refusal as an answer is the single edit that would let an
 ;; unaccounted-for contribution commit.
 {:id :not-accounted-for-is-not-an-answer
  :invariant "計上なしは回答ではない（answers 集合に入れてはならない）"
  :file "src/payroll/shakai_hoken.cljc"
  :find "  #{:accounted-for :not-covered})"
  :replace "  #{:accounted-for :not-covered :not-accounted-for})"}

 ;; A fraction of a yen is not a whole-yen accounting, and the bound argument
 ;; depends on the declared amount being whole yen.
 {:id :a-fraction-of-a-yen-is-not-an-accounting
  :invariant "計上額は円単位（円未満の端数を受け付けない）"
  :file "src/payroll/shakai_hoken.cljc"
  :find "  (and (number? x) (not (neg? x)) (zero? (mod x 1))))"
  :replace "  (and (number? x) (not (neg? x))))"}

 ;; YYYY-MM is refused for any other shape precisely so that lexicographic
 ;; comparison is chronological comparison.
 {:id :the-month-format-is-a-real-month
  :invariant "月分は YYYY-MM のみ（13 月を通さない）"
  :file "src/payroll/shakai_hoken.cljc"
  :find "  #\"^\\d{4}-(0[1-9]|1[0-2])$\")"
  :replace "  #\"^\\d{4}-\\d{2}$\")"}

 ;; Only the last row of 第八十一条第四項's table was transcribed; a month
 ;; before it must be refused rather than rated at 183.
 {:id :a-month-before-the-transcribed-row-is-refused
  :invariant "転記していない料率行の月分に 183 を当てない"
  :file "src/payroll/shakai_hoken.cljc"
  :find "                      (neg? (compare month (:rate/applies-from-month rate))))"
  :replace "                      (and false (compare month (:rate/applies-from-month rate))))"}

 ;; The wiring: rules 12-14 actually reach the verdict.
 {:id :social-insurance-refusals-reach-the-verdict
  :invariant "shakai-hoken の refusal が HARD violation になる"
  :file "src/payroll/governor.cljc"
  :find "     (if hoken (social-insurance-violations hoken) [])"
  :replace "     (if false (social-insurance-violations hoken) [])"}

 ;; The rule NAMES matter: an operator reads them.
 {:id :the-coverage-rule-is-named-not-unclassified
  :invariant "各 refusal が固有の rule 名を持つ"
  :file "src/payroll/governor.cljc"
  :find "   :coverage-not-observed :social-insurance-coverage-not-observed"
  :replace "   :coverage-not-observed-typo :social-insurance-coverage-not-observed"}

 ;; 社会保険 is not tax, and the verdict must not file it under one.
 {:id :social-insurance-is-not-nested-under-tax
  :invariant "verdict の :social-insurance は :tax の子ではない"
  :file "src/payroll/governor.cljc"
  ;; The anchor moved on 2026-08-25: `:wage-basis` was inserted ahead of
  ;; `:social-insurance` in the verdict's `:extra`, so the old `:find`
  ;; (`{:social-insurance`, with the opening brace) no longer occurs. A
  ;; mutation whose `:find` is absent is UNMEASURED, not passing — the
  ;; harness refuses it rather than scoring it, which is how this was caught.
  :find "\n         :social-insurance\n         (cond"
  :replace "\n         :tax-social-insurance\n         (cond"}

 ;; 仕訳: the identity that catches a contribution deducted and not posted.
 {:id :the-journal-identity-counts-social-insurance
  :invariant "gross = 所得税 + 社会保険 + 雇用保険 + net"
  :file "src/payroll/shiwake.cljc"
  :find "      (not= gross (+ income-tax-withheld si-total ei-total net))"
  :replace "      (not= gross (+ income-tax-withheld net))"}

 ;; 健保法 第百六十一条第二項 / 厚年法 第八十二条第二項 (monthly, to the insurer)
 ;; and 労働保険徴収法 (annual, for a 保険年度) are different liabilities.
 {:id :the-two-new-liabilities-are-two
  :invariant "社会保険料預り金 と 雇用保険料預り金 を一本にまとめない"
  :file "src/payroll/shiwake.cljc"
  :find "                 (pos? ei-total)\n                 (conj {:side :cr :account employment-insurance"
  :replace "                 (and false (pos? ei-total))\n                 (conj {:side :cr :account employment-insurance"}

 ;; --------------------------------------------------------------------------
 ;; Added 2026-08-25 with the operator console, the artifacts and the
 ;; MoneyForward boundary. Same scope rule as the header: a clean run means
 ;; every invariant listed here is measured, never that this actor is.
 ;; --------------------------------------------------------------------------

 ;; 賃金の基礎 (rule 15). Rule 4 proves the advisor did not invent the number;
 ;; this is the rule that notices the number ignores a registered fact.
 {:id :a-registered-premium-fact-holds-the-run
  :invariant "gross が無視している登録事実があれば run は保留される"
  :file "src/payroll/governor.cljc"
  :find "     (if (and basis (not (:chingin/certifiable? basis)))"
  :replace "     (if (and basis false (not (:chingin/certifiable? basis)))"}

 ;; An omitted report and a satisfied rule look the same.
 {:id :every-draft-verdict-reports-the-wage-basis
  :invariant "月給 run で勤怠が読まれていないことが verdict に出る"
  :file "src/payroll/governor.cljc"
  :find "\n         :wage-basis\n         (cond"
  :replace "\n         :wage-basis-omitted\n         (cond"}

 ;; The constructor refusal that keeps an unknown figure from rendering as a
 ;; number in every view that reads `:figure/amount` first.
 {:id :a-numberless-provenance-may-not-carry-a-number
  :invariant ":unknown / :held / :not-applicable は金額を持てない"
  :file "src/payroll/provenance.cljc"
  :find "  (when (and (some? amount) (contains? numberless provenance))"
  :replace "  (when (and false (some? amount) (contains? numberless provenance))"}

 ;; A summary somebody types into a payment must not under-report.
 {:id :a-total-refuses-rather-than-under-reporting
  :invariant "未確定を含む合計は合計ではない"
  :file "src/payroll/provenance.cljc"
  :find "    (if (seq blocked)"
  :replace "    (if (and false (seq blocked))"}

 ;; A blank cell is read as zero by the person opening it.
 {:id :an-unknown-figure-is-never-an-empty-cell
  :invariant "未確定の金額は空欄ではなく「未確定」と印字される"
  :file "src/payroll/artifact/text.cljc"
  :find "    (:unknown :held) unknown-cell"
  :replace "    (:unknown :held) \"\""}

 ;; The evidence floor. A checker handed nothing finds nothing.
 {:id :an-empty-accessibility-scan-is-not-a-pass
  :invariant "走査対象ゼロは合格ではない"
  :file "src/payroll/ui/a11y.cljc"
  :find "  (and (empty? (:a11y/findings result))\n       (pos? (get-in result [:a11y/scanned :elements] 0))))"
  :replace "  (empty? (:a11y/findings result)))"}

 ;; A state that reaches the operator only as a colour does not reach an
 ;; operator who cannot see the colour.
 {:id :state-is-never-conveyed-by-colour-alone
  :invariant "状態クラスを持つ要素はテキストか aria-label を持つ"
  :file "src/payroll/ui/a11y.cljc"
  ;; The `:when` clause and not the `finding` call: wrapping the call in a
  ;; `(when false …)` leaves the form unbalanced, the reader fails, and the
  ;; harness scores it UNMEASURED — correctly, since a mutation that breaks
  ;; the build demonstrates the build. Measured 2026-08-25.
  :find "                :when (and (some (fn [p] (some #(str/starts-with? % p) cs))"
  :replace "                :when (and false (some (fn [p] (some #(str/starts-with? % p) cs))"}

 ;; A reconciliation over zero compared runs would print like a perfect month.
 {:id :a-reconciliation-over-nothing-is-not-a-pass
  :invariant "突合できた run が 0 件なら reconciled? は false"
  :file "src/payroll/mf/reconcile.cljc"
  :find "            (zero? compared)"
  :replace "            (and false (zero? compared))"}

 ;; The state every held run lands in, and the one a naive reconciliation
 ;; would score as agreement.
 {:id :a-held-figure-is-never-scored-as-agreement
  :invariant "当 actor が保留した項目は「一致」にならない"
  :file "src/payroll/mf/reconcile.cljc"
  :find "      (assoc base :field/verdict :not-comparable\n             :field/why (str label \"について当 actor は数字を出していない: \""
  :replace "      (assoc base :field/verdict :agree\n             :field/why (str label \"について当 actor は数字を出していない: \""}

 ;; No column name has been checked against a real export.
 {:id :no-moneyforward-column-is-marked-verified
  :invariant "MF の列名はすべて未検証である"
  :file "src/payroll/mf/schema.cljc"
  :find "  [{:mf/column \"従業員番号\" :mf/to :employee-number :mf/kind :identity\n    :mf/required? true :mf/verified? false}"
  :replace "  [{:mf/column \"従業員番号\" :mf/to :employee-number :mf/kind :identity\n    :mf/required? true :mf/verified? true}"}

 ;; The registration layer is not a second governor.
 {:id :registration-does-not-default-a-coverage-flag
  :invariant "未登録の被保険者資格を false で埋めない"
  :file "src/payroll/touroku.cljc"
  :find "         :touroku/record (merge m stamp)"
  :replace "         :touroku/record (merge {:employment/health-insurance-insured? false} m stamp)"}

 ;; Widening the bind address without the acknowledgement makes the trusted
 ;; header trustworthy by nothing.
 {:id :a-non-loopback-bind-needs-an-acknowledgement
  :invariant "loopback 以外への bind は PAYROLL_TRUST_FORWARDED を要する"
  :file "src/payroll/host/config.cljc"
  :find "      (and (not loopback?) (not forwarded-ack?))"
  :replace "      (and false (not loopback?) (not forwarded-ack?))"}

 ;; The one thing on this surface a page on another origin could trigger.
 {:id :the-console-refuses-a-cross-origin-post
  :invariant "別 origin からのフォーム POST は拒否される"
  :file "src/payroll/edge/console.cljc"
  :find "    (and (= :post method) (not (same-origin? origin self-origin)))"
  :replace "    (and false (= :post method) (not (same-origin? origin self-origin)))"}

 ;; A plausible-looking 明細書 whose title asserts statutory compliance is the
 ;; most expensive kind of wrong this repository can be.
 {:id :the-payslip-does-not-claim-to-be-a-statutory-form
  :invariant "給与支払明細書は法定様式であると主張しない"
  :file "src/payroll/artifact/payslip.cljc"
  :find "      [:statutory_form false]"
  :replace "      [:statutory_form true]"}

 ;; --------------------------------------------------------------------------
 ;; 6. The persistent schemas added on 2026-08-26 — the durable store, the
 ;;    keyed blind index, the analytical projection and the cutover evidence.
 ;;
 ;;    This is the block where a surviving mutation would mean the durability
 ;;    work was never measured. Each of these invariants is one this actor
 ;;    now RELIES on rather than refuses: the ledger is no longer allowed to
 ;;    be empty because it could not be read, a redelivered `:commit` is no
 ;;    longer allowed to be a second payment, and a `MemStore` is no longer
 ;;    allowed to satisfy the gate that switches off the incumbent.
 ;; --------------------------------------------------------------------------

 ;; An unreadable chain returning what it got is the one shape this whole
 ;; repository is organised against: fewer entries look exactly like fewer
 ;; records, and on the ledger that approves the month's second payroll run.
 {:id :an-unreadable-chain-refuses-rather-than-returning-what-it-got
  :invariant "読めない chain は空の chain ではない（entries-of は fail closed）"
  :file "src/payroll/store/kotobase.cljc"
  :find "    (if (:chain/complete? chain)"
  :replace "    (if (or true (:chain/complete? chain))"}

 ;; Without re-deriving the address, a node that serves altered bytes gets
 ;; its alteration parsed as EDN and walked as a chain node.
 {:id :a-block-is-verified-against-the-address-it-was-asked-for
  :invariant "返ってきた bytes の内容アドレスを照合する"
  :file "src/payroll/store/kotobase.cljc"
  :find "        (if (not= cid actual)"
  :replace "        (if (and false (not= cid actual))"}

 ;; Appending against a chain that cannot be walked writes the record a
 ;; second time whenever the block carrying the first one is the unreadable
 ;; one.
 {:id :an-append-against-an-unwalkable-chain-does-not-happen
  :invariant "辿れない chain に追記しない"
  :file "src/payroll/store/kotobase.cljc"
  :find "                (not (:chain/complete? chain))"
  :replace "                (and false (not (:chain/complete? chain)))"}

 ;; The tags travel in the clear. An unkeyed hash over a guessable contract
 ;; id lets anybody who can read the chain confirm that an employee is on
 ;; this payroll without opening one sealed payload.
 ;; ⚠ This entry was RE-ANCHORED after being measured. Its first form
 ;; disabled `append!`'s own refusal when the provider will not tag, and it
 ;; SURVIVED — because `store` refuses to build on such a provider in the
 ;; first place, so no test ever reaches the second check. That is correct
 ;; defence in depth and a useless mutation: the surviving one measured
 ;; nothing, and a table entry that cannot go red is exactly the shape this
 ;; harness exists to catch. It now mutates the check the suite does reach.
 {:id :the-idempotency-tag-comes-from-a-keyed-provider
  :invariant "冪等性の tag は鍵付きプロバイダから来る（無鍵ハッシュは確認オラクル）"
  :file "src/payroll/store/kotobase.cljc"
  :find "                     (not (and (blind/configured? blind-index)"
  :replace "                     (not (and (or true (blind/configured? blind-index))"}

 ;; One keychain item wired into two environment variables is the likely way
 ;; this happens, and it passes every other check.
 {:id :the-blind-index-key-is-not-the-envelope-key
  :invariant "blind index の鍵は封筒の鍵と別でなければならない"
  :file "src/payroll/kotobase/blind_index.cljc"
  :file2-note "mutates the predicate itself, so the form stays balanced"
  :find "  (not (or (identical? b envelope*)"
  :replace "  (not (and (identical? b envelope*)"}

 ;; A provider whose tag changes per call makes every redelivery a first
 ;; write; one whose tag is constant collapses two contracts into one.
 {:id :an-unstable-blind-index-is-refused-at-construction
  :invariant "tag が安定しない・定数のプロバイダは構成時に拒否される"
  :file "src/payroll/kotobase/blind_index.cljc"
  :find "               (= (:index/tag a) (:index/tag a'))"
  :replace "               (or true (= (:index/tag a) (:index/tag a')))"}

 ;; A MemStore holding three reconciled cycles satisfies every other
 ;; condition, and the whole evidence for switching off the incumbent would
 ;; be inside a process that ends when it ends.
 {:id :the-cutover-gate-needs-a-store-that-can-testify-to-its-durability
  :invariant "MemStore は3サイクル揃っていても cutover gate を満たさない"
  :file "src/payroll/cutover.cljc"
  :find "        durable? (and (= :kotobase (:evidence/mode evidence))\n                      (true? (:evidence/survives-process-restart? evidence)))"
  :replace "        durable? (or true (= :kotobase (:evidence/mode evidence))\n                      (true? (:evidence/survives-process-restart? evidence)))"}

 ;; `not durable` and `not readable` are separate facts with separate
 ;; operator actions, and the gate has to require both.
 {:id :the-cutover-read-back-needs-every-chain-walked-to-its-end
  :invariant "一つでも辿れない chain があれば読み戻しの条件は満たされない"
  :file "src/payroll/cutover.cljc"
  :find "          :gate/met? (and durable? readable? read-back?"
  :replace "          :gate/met? (and durable? (or true readable?) read-back?"}

 ;; A projection that appended zero rows because it was handed no rows is a
 ;; projection over nothing, and reporting it as `:ok` is the evidence-floor
 ;; failure this repository keeps finding.
 {:id :a-projection-over-nothing-is-not-a-successful-projection
  :invariant "行が0件の投影は :nothing-to-do であって :ok ではない"
  :file "src/payroll/projection/catalog.cljc"
  :find "      {:project/status :nothing-to-do :project/appended 0 :project/skipped []"
  :replace "      {:project/status :ok :project/appended 0 :project/skipped []"}

 ;; A driver that cannot answer `which keys are already there` cannot be
 ;; appended to: every re-run would load the payroll run again.
 {:id :a-driver-that-cannot-answer-existing-keys-is-not-written-to
  :invariant "既存の鍵を答えられない driver には追記しない"
  :file "src/payroll/projection/catalog.cljc"
  :find "      (not= :ok (:catalog/status existing))"
  :replace "      (and false (not= :ok (:catalog/status existing)))"}

 ;; A row that silently dropped a forbidden column looks de-identified and
 ;; leaves a caller believing the column was never there.
 {:id :a-projected-row-refuses-rather-than-dropping-an-identifier
  :invariant "投影行は禁止列を黙って落とさず拒否する"
  :file "src/payroll/sensitive.cljc"
  :find "  (blocked? (map :sensitive/key forbidden-outside) k))"
  :replace "  (and false (blocked? (map :sensitive/key forbidden-outside) k)))"}

 ;; A 120-byte record survives exactly one encoding, and a host that
 ;; re-encoded the string would make every halfwidth katakana three bytes.
 {:id :the-host-writes-zengin-bytes-without-re-encoding-them
  :invariant "固定長ファイルの bytes は UTF-8 で再エンコードされない"
  :file "src/payroll/host/jvm.clj"
  :find "    (sequential? body) (byte-array (map #(unchecked-byte (bit-and (int %) 0xFF))"
  :replace "    (sequential? body) (byte-array (map #(unchecked-byte (bit-and (int 63) 0xFF))"}

 ;; `String.getBytes` substitutes `?` for a character the charset cannot
 ;; represent, silently, and the record stays the right length — so the one
 ;; failure this namespace exists to prevent would pass every length check.
 {:id :a-character-with-no-single-byte-encoding-is-refused
  :invariant "1バイトにならない文字は置き換えず拒否する"
  :file "src/payroll/artifact/zengin.cljc"
  :find "    (if (seq problems)
      {:bytes/status :refused :bytes/problems problems"
  :replace "    (if (and false (seq problems))
      {:bytes/status :refused :bytes/problems problems"}

 ;; --------------------------------------------------------------------------
 ;; 7. 住民税の通知の永続化 and its de-identified projection (2026-08-26).
 ;;
 ;;    住民税 is the one figure this actor never computes, so the only ways it
 ;;    can be wrong are ways of WRITING it: transcribed twice, transcribed
 ;;    differently under one id, corrected without saying what was corrected,
 ;;    or appended against a history nobody could read to the end. Every entry
 ;;    in this block breaks one of those guards, and each of them fails
 ;;    silently — an employer deducting a figure no municipality asked for
 ;;    finds out when the 納入書 arrives with a different total.
 ;;
 ;;    The two projection entries are about the OTHER direction: what leaves
 ;;    for the analytical catalog. There the failure is a row that looks
 ;;    de-identified and a reader who believes the column was never there.
 ;; --------------------------------------------------------------------------

 ;; An operator who clicks twice has transcribed one piece of paper once. A
 ;; second copy on this stream is a second answer to `which paper is current`.
 {:id :a-retried-registration-is-one-registration
  :invariant "同じ内容の再送は :duplicate であって二度目の登録ではない"
  :file "src/payroll/juminzei.cljc"
  :find "      (and same (= same record))"
  :replace "      (and false same (= same record))"}

 ;; 「訂正した」とだけ言う通知は、同じ年度について二つの通知を並べるだけで、
 ;; どちらの月割額を控除すべきか誰にも答えられない。
 {:id :a-correction-must-name-what-it-replaces
  :invariant "改訂番号が1以上なら :notice/replaces を名指ししなければならない"
  :file "src/payroll/juminzei.cljc"
  :find "      (and (pos? revision) (str/blank? (str replaces)))"
  :replace "      (and false (pos? revision) (str/blank? (str replaces)))"}

 ;; Two disagreeing answers under one id: every later read returns whichever
 ;; the backend happened to hand back last, and nothing reports the fork.
 {:id :the-same-notice-id-with-different-content-is-refused
  :invariant "同じ :notice/id が別の内容で登録されることはない"
  :file "src/payroll/juminzei.cljc"
  :find "      same\n      {:registration/status :refused\n       :registration/reason :conflicting-content"
  :replace "      (and false same)\n      {:registration/status :refused\n       :registration/reason :conflicting-content"}

 ;; A history that cannot be read to its end cannot answer 「これは既に登録
 ;; されているか」, and appending against a partial read is registering
 ;; without checking idempotency — which on this stream produces two notices
 ;; under one id, the exact fork `notice-id` exists to prevent.
 {:id :a-notice-is-not-appended-against-an-unreadable-history
  :invariant "末尾まで読めない履歴に追記しない（読めない履歴は空の履歴ではない）"
  :file "src/payroll/juminzei.cljc"
  :find "    (if-not (:read/ok? read*)"
  :replace "    (if-not (or true (:read/ok? read*))"}

 ;; Both numbers are printed on the same piece of paper, so a disagreement
 ;; between them is a transcription error and never a smaller tax. A dropped
 ;; digit would otherwise be deducted every month for a year and look
 ;; entirely lawful.
 {:id :a-decision-notices-twelve-months-must-sum-to-its-annual-total
  :invariant "決定通知書の12か月の月割額は年税額に一致する"
  :file "src/payroll/juminzei.cljc"
  :find "      (and summed (not= summed (:notice/annual-total m)))"
  :replace "      (and false summed (not= summed (:notice/annual-total m)))"}

 ;; One employer's notices are another employer's tax bill. The write side is
 ;; guarded by the store's own scoping; this is the READ side, and an
 ;; unscoped read hands a municipality's decision about one payroll to
 ;; whoever asks about another.
 {:id :the-notice-chain-is-employer-scoped
  :invariant "通知の読み出しは :notice/employer で絞られる"
  :file "src/payroll/store/kotobase.cljc"
  :find "(filterv #(= client-id (:notice/employer %)) (entries-of s :juminzei))"
  :replace "(filterv (constantly true) (entries-of s :juminzei))"}

 ;; For the notice table the SCHEMA is the de-identification: 区市町村,
 ;; 通知書番号 and the twelve 月割額 are simply not declared, so a row that
 ;; carries one has to be refused. Dropping it instead produces a row that
 ;; looks de-identified and a caller who believes the column was never there.
 ;; (The sibling entry above breaks the `payroll.sensitive` half; this one
 ;; breaks the undeclared-column half, and they are different guards.)
 {:id :a-projected-row-refuses-an-undeclared-column
  :invariant "表が宣言していない列は黙って落とさず拒否する"
  :file "src/payroll/projection/schema.cljc"
  :find "        undeclared (vec (remove (column-names table) (map name (keys row))))"
  :replace "        undeclared (vec (remove (constantly true) (map name (keys row))))"}

 ;; A notice projection handed no rows is a projection over nothing. Reported
 ;; as `:ok` it reads as 「通知の履歴は投影済み」 about a run that looked at
 ;; nothing. `:a-projection-over-nothing-is-not-a-successful-projection` above
 ;; breaks the STATUS this branch returns; this one breaks the GUARD that
 ;; reaches it, so the branch is never entered at all — the same invariant
 ;; from the only other side it can fail from.
 {:id :a-notice-projection-over-nothing-does-not-reach-the-ok-path
  :invariant "行が0件なら :nothing-to-do の枝に入る（:ok の枝には落ちない）"
  :file "src/payroll/projection/catalog.cljc"
  :find "      (empty? rows)"
  :replace "      (and false (empty? rows))"}

 ;; --------------------------------------------------------------------------
 ;; 8. Two invariants this table's own SCOPE comment named as UNCOVERED
 ;;    (2026-08-26). Both are load-bearing and neither had ever been shown
 ;;    capable of failing here.
 ;; --------------------------------------------------------------------------

 ;; A report that quietly removed a field is a report a reader believes was
 ;; complete. Dropping is half the invariant; the COUNT is the other half,
 ;; and it is the half that tells the reader something was removed at all.
 {:id :redaction-counts-what-it-dropped
  :invariant "落とした鍵は数えて :report/redacted-keys で報告する"
  :file "src/payroll/operations.cljc"
  :find "(assoc cleaned :report/redacted-keys @n)"
  :replace "(assoc cleaned :report/redacted-keys 0)"}

 ;; 「未転記の支部に近い支部の率を当てる」は、もっともらしい給与明細が毎月
 ;; 少しずつ間違うということである。The refusal is the whole point of the
 ;; prefecture being a REGISTERED fact rather than a defaulted one.
 {:id :an-untranscribed-prefecture-fails-closed
  :invariant "転記していない支部の料率は隣の支部で代用されない"
  :file "src/payroll/rates.cljc"
  :find "                                          (or (= :all (:rate/prefecture r))"
  :replace "                                          (or true (= :all (:rate/prefecture r))"}

 ;; --------------------------------------------------------------------------
 ;; 9. 住民税 — the read that joins a registered classification to a payslip
 ;;    figure (added 2026-08-26).
 ;;
 ;;    `:employment/resident-tax-obligation` was not one of
 ;;    `payroll.touroku/contract-fields` until this change, so no contract
 ;;    could carry it, `:obligation` was nil everywhere, and this read
 ;;    returned nil no matter what anybody registered. The suite was green
 ;;    throughout — nothing exercised the path, because nothing could reach
 ;;    it. That is the shape this entry exists to make impossible again.
 ;; --------------------------------------------------------------------------

 ;; Breaking the READ and not the field inventory: a 住民税 line held for
 ;; `:municipality-not-declared` on a contract that IS classified is
 ;; indistinguishable, on the screen, from one nobody has classified — and
 ;; the whole notice stream, the transcription form and the coverage panel
 ;; produce no payslip figure between them while it is true.
 {:id :the-payslip-reads-the-obligation-off-the-contract
  :invariant "登録された特別徴収の区分が明細の住民税の行に届く（未登録と同じ扱いにしない）"
  :file "src/payroll/edge/console.cljc"
  :find "                                          :obligation (:employment/resident-tax-obligation\n                                                       contract)"
  :replace "                                          :obligation (:employment/resident-tax-obligation\n                                                       nil)"}
]
