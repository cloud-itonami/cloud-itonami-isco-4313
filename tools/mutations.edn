  :replace ":nenmatsu/over-or-under (- withheld-recorded 0)"}

 {:id :the-years-tax-is-never-computed
  :invariant "and neither is the year's correct tax — 別表 was not read"
  :file "src/payroll/nenmatsu.cljc"
  :find ":nenmatsu/annual-tax :not-computable"
  :replace ":nenmatsu/annual-tax 0"}

 {:id :the-unread-table-is-named
  :invariant "the refusal names WHICH table nobody read, read off taxlaw"
  :file "src/payroll/nenmatsu.cljc"
  :find "   (:rule/amount-source-not-read\n    (taxlaw/facet-of jurisdiction :jurisdiction/wage-withholding))"
  :replace "   (:rule/no-such-key\n    (taxlaw/facet-of jurisdiction :jurisdiction/wage-withholding))"}

 {:id :the-recorded-sums-are-this-actors-own
