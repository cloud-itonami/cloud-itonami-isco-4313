  :file "src/payroll/edge/endpoints.cljc"
  :find "     (nil? (employer-for allowlist caller-did))\n     {:status 403 :body {:ok false :error \"caller not permitted\"}}\n\n     :else\n     (let [{:keys [fields error]} (parse-year-end-body raw-body)]"
  :replace "     (nil? nil)\n     {:status 403 :body {:ok false :error \"caller not permitted\"}}\n\n     :else\n     (let [{:keys [fields error]} (parse-year-end-body raw-body)]"}

 {:id :the-year-end-body-cannot-name-an-employer
  :invariant "whose 年末調整 this is comes from the verified DID"
  :file "src/payroll/edge/endpoints.cljc"
  :find "      (some #(contains? m %) employer-naming-keys)\n      {:error (str \"the employer is taken from the verified caller, not the\"\n                   \" request body\")}\n\n      (not (and (string? (:year m)) (seq (.trim (:year m)))))"
  :replace "      (some #(contains? #{} %) employer-naming-keys)\n      {:error (str \"the employer is taken from the verified caller, not the\"\n                   \" request body\")}\n\n      (not (and (string? (:year m)) (seq (.trim (:year m)))))"}

 {:id :a-non-boolean-declaration-is-refused-at-the-edge
  :invariant "a string is not a declaration, and the caller who sent one is told"
  :file "src/payroll/edge/endpoints.cljc"
  :find "        boolish? (fn [k] (or (nil? (get m k)) (boolean? (get m k))))"
  :replace "        boolish? (fn [k] (or (nil? (get m k)) (some? (get m k))))"}

 {:id :not-assessed-is-not-an-answer
  :invariant "a verdict that carried no assessment must not print as answerable"
  :file "src/payroll/edge/endpoints.cljc"
  :find "    {:answer :not-assessed :answerable? false}))"
  :replace "    {:answer :not-assessed :answerable? true}))"}

 {:id :the-ledger-names-the-op
  :invariant "an assessment record must not render as a payroll run that paid nothing"
  :file "src/payroll/edge/endpoints.cljc"
  :find "                                :op (get-in e [:record :op])"
  :replace "                                :op nil"}

 {:id :the-contract-history-names-the-op
