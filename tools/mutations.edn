  :find "(str/starts-with? (str (get-in r [:payload :period])) (str year))"
  :replace "(str/starts-with? (str (get-in r [:payload :period])) \"\")"}

 {:id :another-contracts-run-is-not-this-employees-wages
  :invariant "and so must the contract"
  :file "src/payroll/nenmatsu.cljc"
  :find "(= contract-id (:contract-id r))"
  :replace "(some? (:contract-id r))"}

 {:id :a-nenmatsu-refusal-is-a-hard-violation
