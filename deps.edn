{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; kotoba-lang/labor is this vertical's bespoke domain capability
        ;; library (contracts, timesheets, wages, payroll). Referenced by
        ;; workspace-sibling path per the fleet's capability-library-
        ;; wrapping convention (same as cloud-itonami-isic-9700) — labor's
        ;; own deps use sibling paths, so it is not consumable as a git
        ;; dep; forks need the kotoba-lang workspace layout.
        io.github.kotoba-lang/labor
        {:local/root "../../kotoba-lang/labor"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
