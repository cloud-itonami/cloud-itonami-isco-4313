;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: ISCO 4313 (Payroll Clerks) is a Wave 0 (cognitive substrate)
;; occupation with no robotics gate -- the actor computes pay. The physical
;; work that remains is paper pay records: a robot loads trays of printed,
;; sealed payslip envelopes into the franking / sorting station, and a
;; courier robot distributes the envelope tray to a site office across the
;; premises on pay day.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4313"
 :cases
 [{:id :payslip-tray-to-sorter
   :kind :manipulator
   :procedure "arm lifts a tray of sealed payslip envelopes from the printer output onto the sorting station"
   :params {:l1-m 0.35 :l2-m 0.30 :m1-kg 3.0 :m2-kg 2.0
            :from [0.40 0.00] :to [0.10 0.45] :duration-s 1.5 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.5 3.0 4.5 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 35.0 :basis "estimate: continuous shoulder torque of a ~3 kg-payload desktop collaborative arm"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :payday-envelope-run
   :kind :transport
   :procedure "courier robot carries the pay-day envelope tray from the payroll office to a site office 150 m away"
   :params {:mass-kg 35.0 :payload-kg 6.0 :distance-m 150.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 80.0 :crr 0.02
            :cog-height-m 0.50 :support-half-length-m 0.25}
   :sweep {:param :v-max-mps :values [0.5 0.8 1.0 1.2 1.5]}
   :quantity :cycle-time-s
   :limit {:max 180.0 :basis "estimate: a 3-minute leg so envelopes reach the site office within the shift-change window"}
   :boundary {:lo 0.3 :hi 2.0}}]}
